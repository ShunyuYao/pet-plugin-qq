{
  "id": "qq-context",
  "name": "QQ 宠物连接",
  "description": "把已有 DSH 宠物接到桌面，与主人 QQ 私聊共用原会话。",
  "version": "0.1.0",
  "apiVersion": 1,
  "kind": ["tool", "panel", "service"],
  "permissions": ["storage", "secrets", "events", "ui", "conversation", "net:127.0.0.1", "net:localhost"],
  "services": ["qq-context"],
  "provides": { "service": "qq-context", "methods": ["state", "connect", "disconnect", "reconnect", "start", "poll", "history", "cancel"] },
  "entry": { "tool": "index.cjs", "panel": { "src": "panel/index.html", "width": 640, "height": 760, "title": "QQ 宠物连接" } }
}
